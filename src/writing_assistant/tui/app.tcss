/* Writing Assistant TUI — visual theme.
   Palette echoes the web UI: an indigo primary, soft surfaces, a green
   "use this text" action, and a clearly delineated suggestion panel. */

Screen {
    background: $surface;
}

.hidden {
    display: none;
}

.muted {
    color: $text-muted;
}

.section-heading {
    margin-top: 1;
    text-style: bold;
    color: $primary;
}

.status-line {
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    color: $text-muted;
}

.status-line.error {
    color: $error;
}

.status-line.success {
    color: $success;
}

/* ---- Login ------------------------------------------------------------- */

#login-wrapper {
    align: center middle;
    height: 1fr;
}

/* A scrolling box that fits in 24 rows (register mode scrolls). */
#login-box {
    width: 64;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 0 3;
    border: round $primary;
    background: $panel;
}

#login-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin-bottom: 0;
}

#login-tagline {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

#login-box Label {
    margin-top: 0;
    color: $text-muted;
}

#login-box .status-line {
    margin: 0;
}

#login-box Input {
    margin-top: 0;
}

/* ---- Editor -------------------------------------------------------------- */

#topbar {
    height: 1;
    background: $primary;
    color: $text;
    padding: 0 1;
}

#brand {
    width: auto;
    text-style: bold;
}

#filename {
    width: 1fr;
    text-align: center;
    text-style: italic;
}

#user {
    width: auto;
    color: $text-muted;
}

#workspace {
    height: 1fr;
    padding: 0 1;
}

/* No vertical margins anywhere in the workspace: every row saved here is
   a row of document text at 80x24. */
#title {
    margin: 0;
    border: tall $primary-darken-1;
}

#title:focus {
    border: tall $primary;
}

/* The editor gets the larger share: nine rows of text at 80x24 (the
   suggestion panel keeps its minimum below), 14 at 100x30, 21 at 132x43. */
#editor {
    height: 5fr;
    min-height: 4;
    margin: 0;
    border: round $primary-darken-1;
    background: $panel;
}

#editor:focus {
    border: round $primary;
}

#suggestion-panel {
    /* Minimum: border (2) + header (1) + 4 text rows + mode bar (3). Below
       ~22 rows the screen gets the `compact` class (see EditorScreen) and
       the mode bar is hidden — the keys still work and the footer lists
       them — so the panel stays on screen down to 16 rows. */
    height: 4fr;
    min-height: 10;
    margin: 0;
    border: round $secondary;
    background: $panel;
}

EditorScreen.compact #suggestion-panel {
    min-height: 6;
}

EditorScreen.compact #mode-bar {
    display: none;
}

/* Narrow terminals: shorter button labels are swapped in by the screen. */
EditorScreen.narrow #mode-bar Button {
    margin: 0;
    min-width: 8;
}

#suggestion-header {
    height: 1;
    padding: 0 1;
    background: $secondary-darken-2;
}

#section-info {
    width: 1fr;
    text-style: bold;
}

#section-status {
    width: auto;
    color: $warning;
}

#suggestion-scroll {
    height: 1fr;
    padding: 0 1;
}

#suggestion-text {
    width: 1fr;
}

#mode-bar {
    height: 3;
    align: center middle;
}

#mode-bar Button {
    margin: 0 1;
    min-width: 12;
}

Button.mode {
    background: $primary-darken-1;
    color: $text;
    border-top: tall $primary-lighten-1;
    border-bottom: tall $primary-darken-3;
}

Button.mode:hover {
    background: $primary;
}

#use-suggestion {
    margin-left: 2;
}

/* ---- Dialogs ---------------------------------------------------------- */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 66;
    max-width: 100%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

.dialog-wide {
    width: 90;
}

.dialog-menu {
    width: 48;
}

/* Long text (Help): the body scrolls, the OK button stays on screen. */
.dialog-message {
    height: 90%;
}

.dialog-message .dialog-body {
    height: 1fr;
    max-height: 100%;
}

.dialog-settings {
    width: 100;
    height: 90%;
}

/* Short terminals (fewer than 24 rows): the hint line and the vertical
   padding go, and the dialog takes the whole height, so the form keeps a
   few rows to scroll in and the buttons stay on screen (at 60x16 nothing
   but the title and tab bar was visible). */
.dialog-settings.compact {
    height: 100%;
    max-height: 100%;
    padding: 0 2;
}

.dialog-settings.compact .dialog-hint {
    display: none;
}

.dialog-settings.compact .dialog-title {
    margin-bottom: 0;
}

.dialog-settings.compact .dialog-buttons {
    margin-top: 0;
}

.dialog-settings TabbedContent {
    height: 1fr;
}

.dialog-settings VerticalScroll {
    height: 1fr;
    padding: 0 1;
}

/* Four buttons in a row must fit a 70-column terminal. */
.dialog-settings .dialog-buttons Button {
    min-width: 8;
}

/* The picker's filter field sits directly above the list. */
.picker-filter {
    margin: 0 0 1 0;
}

.dialog-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.dialog-hint {
    color: $text-muted;
    margin-bottom: 1;
}

.dialog-body {
    height: auto;
    max-height: 30;
    margin-bottom: 1;
}

.dialog Label {
    margin-top: 1;
    color: $text-muted;
}

/* A prompt's caption: wraps when longer than the dialog. */
.dialog .prompt-label {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

.dialog-buttons {
    height: auto;
    margin-top: 1;
    align: left middle;
}

.dialog-buttons Button {
    margin-right: 1;
}

/* Flexible so the dialog (and its buttons) still fit in 24 rows. */
.dialog-textarea {
    height: 1fr;
    min-height: 3;
    max-height: 10;
    margin-top: 0;
}

.dialog-textarea.small {
    height: 5;
}

.form-row {
    height: auto;
}

.form-col {
    width: 1fr;
    height: auto;
    margin-right: 2;
}

/* Settings → Document: the template dropdown with its two buttons beside it. */
.template-row Select {
    width: 1fr;
}

.template-row Button {
    margin-left: 1;
    min-width: 8;
}

/* The menu and picker lists: `max-height` is lowered from the screen's
   height on resize (see _fit_option_list) so the list scrolls inside the
   dialog instead of the dialog clipping it. */
OptionList {
    height: auto;
    max-height: 20;
    border: round $primary-darken-2;
    background: $surface;
}

OptionList > .option-list--option-highlighted {
    background: $primary;
    color: $text;
}
