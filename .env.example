# Writing Assistant - Environment Variables
# Copy this file to .env and update the values for your deployment

# Server Configuration
WRITING_ASSISTANT_HOST=0.0.0.0
WRITING_ASSISTANT_PORT=8001
WRITING_ASSISTANT_RELOAD=false

# Database Configuration
# Path to SQLite database file
WRITING_ASSISTANT_DB_PATH=/app/data/writing_assistant.db

# Security Configuration
# IMPORTANT: Change this to a strong random secret in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WRITING_ASSISTANT_SECRET=CHANGE_THIS_IN_PRODUCTION_PLEASE

# AI Configuration (Optional)
# All of these can also be set per-user in the web UI (Settings -> AI
# Settings), which includes a "Test Connection" button to verify them.
# Values set here become the server-wide defaults.

# Uncomment and set these if using OpenAI
# OPENAI_API_KEY=sk-your-api-key-here
# Optional alternate OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://api.example.com/v1

# Uncomment and set if using Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Optional alternate Anthropic-compatible endpoint:
# ANTHROPIC_BASE_URL=https://claude-proxy.example.com

# Uncomment and set if using a custom (e.g. remote) Ollama server.
# IMPORTANT (containers): inside a container, "localhost" is the container
# itself. If Ollama runs on the machine hosting the container, use the host
# gateway alias instead (mapped by docker-compose.yml via extra_hosts):
# TALKPIPE_OLLAMA_SERVER_URL=http://host.containers.internal:11434
# TALKPIPE_OLLAMA_SERVER_URL=http://localhost:11434

# Custom Environment Variables Feature
# Set to true to allow users to configure environment variables via the UI
# Set to false for shared/production deployments for security
ALLOW_CUSTOM_ENV_VARS=true
